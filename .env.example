# Equilibra TESH - Variables de entorno
# Modo Demostración no requiere variables locales.
# En la fase de integración con Supabase/Backend, configura estos valores:

# URL del proyecto Supabase (ejemplo: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Clave pública anónima de Supabase (Anon Key segura para cliente)
VITE_SUPABASE_ANON_KEY=
